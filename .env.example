MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=full_stack_data
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_KEY=full_stack:due_jobs
SCHEDULER_INTERVAL_SECONDS=30
WORKER_POOL_SIZE=8
CELERY_BEAT_INTERVAL_SECONDS=10
# Optional: copy this file to `backend/.env` for Uvicorn; for Docker Compose
# blue/green release labels, also copy to project root as `.env` (Compose reads it).
# APP_RELEASE_GREEN=03
# APP_RELEASE_BLUE=02
# CELERY_GREEN_TAG=green-r03
# CELERY_BLUE_TAG=blue-r02
# CELERY_BEAT_TAG=beat
